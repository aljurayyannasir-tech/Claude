{
  "name": "fruitfly-mc-agent",
  "version": "0.1.0",
  "description": "FruitFly: an autonomous Minecraft survival agent (Mineflayer bot) that gathers, farms, builds, expands a city, and logs a training dataset of its decisions while it plays.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "analyze": "python3 scripts/analyze_dataset.py"
  },
  "license": "MIT",
  "dependencies": {
    "mineflayer": "^4.23.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-collectblock": "^1.4.1",
    "mineflayer-auto-eat": "^5.0.2",
    "mineflayer-tool": "^1.2.0",
    "vec3": "^0.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
